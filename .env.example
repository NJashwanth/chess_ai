# ---------------------------------------------------------------------------
# Jev (TypeSafe AI) - Board A
# ---------------------------------------------------------------------------
# Which upstream to send the System One request to: "typesafe" or "openrouter".
JEV_PROVIDER=typesafe

# Direct TypeSafe AI account (https://docs.typesafe.ai/api)
TYPESAFE_API_KEY=ts-...

# Or route the same request body through OpenRouter's Decisions API instead.
# Used when JEV_PROVIDER=openrouter.
OPENROUTER_API_KEY=sk-or-...

# Pinned model version. The version that actually served each request is read
# back from the response and logged per move.
#   JEV_PROVIDER=typesafe   -> jev-1.13.0
#   JEV_PROVIDER=openrouter -> typesafe/jev-1.13
JEV_MODEL=jev-1.13.0

# Optional base-URL overrides (defaults shown). The path /v1/systemone is
# appended by the app.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# ---------------------------------------------------------------------------
# Fable (Anthropic) - Board B
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Pinned model version.
FABLE_MODEL=claude-fable-5-1
